{
  "name": "tankz",
  "version": "1.0.0",
  "description": "A tiny offline browser tank roguelike (top-down 2D) built with PixiJS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "keywords": ["game", "pixijs", "tank", "roguelike", "webgl"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  }
}
